# Copy this file to backend/.env and fill in real values.
# backend/.env is git-ignored - never commit real secrets.

ENVIRONMENT=development

# --- MongoDB -----------------------------------------------------------
# Local dev default: the MongoDB service running on this machine.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=ai_interviewer

# --- LLM provider selection -----------------------------------------------
# auto (default) = Anthropic if ANTHROPIC_API_KEY is set below, else the
# deterministic stub. Set explicitly to force a provider - "stub",
# "anthropic", or "openrouter". An explicit non-"auto" value with its key
# missing fails loudly at startup rather than silently using the stub.
LLM_PROVIDER=auto

# --- LLM (Anthropic Claude, direct) ---------------------------------------
# Get a key at https://console.anthropic.com/
# Leave ANTHROPIC_API_KEY blank to run against the deterministic stub AI
# client instead of a real model (useful for dev without burning API credits).
ANTHROPIC_API_KEY=
# claude-opus-5 is the current recommended default. claude-sonnet-5 is
# cheaper and reasonable for high-volume personal practice sessions.
ANTHROPIC_MODEL=claude-opus-5

# --- LLM (OpenRouter) -------------------------------------------------------
# Get a key at https://openrouter.ai/keys - set LLM_PROVIDER=openrouter above
# to use it. OpenRouter proxies many model providers behind one API.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-5
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_SECONDS=60

# --- Auth (placeholder until Milestone 9 / real auth is built) ---------
JWT_SECRET_KEY=dev-secret-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- CORS ----------------------------------------------------------------
# Only needed if the frontend runs somewhere other than localhost:3000.
# pydantic-settings parses list fields as JSON, e.g.:
# CORS_ORIGINS=["http://localhost:3000","https://myapp.example.com"]

# --- Resume uploads (Milestone 4) ----------------------------------------
MAX_RESUME_SIZE_BYTES=5242880
